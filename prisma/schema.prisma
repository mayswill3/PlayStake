// =============================================================================
// ANOMALY DETECTION
// =============================================================================

model AnomalyAlert {
  id                 String        @id @default(uuid()) @db.Uuid
  developerProfileId String        @map("developer_profile_id") @db.Uuid
  gameId             String?       @map("game_id") @db.Uuid
  type               AnomalyType
  status             AnomalyStatus @default(DETECTED)
  severity           String        @db.VarChar(20)
  details            Json
  autoAction         String?       @map("auto_action") @db.VarChar(100)
  resolvedById       String?       @map("resolved_by_id") @db.Uuid
  resolvedAt         DateTime?     @map("resolved_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([developerProfileId, status], map: "idx_anomaly_developer_status")
  @@index([type, status], map: "idx_anomaly_type_status")
  @@index([createdAt], map: "idx_anomaly_created")
  @@map("anomaly_alerts")
}

enum LobbyRole {
  PLAYER_A
  PLAYER_B
}

enum LobbyStatus {
  WAITING
  INVITED
  MATCHED
  EXPIRED
  CANCELLED
}

enum StreamChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model LobbyEntry {
  id              String      @id @default(cuid())
  gameType        String      @map("game_type") @db.VarChar(50)
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation("LobbyUser", fields: [userId], references: [id])
  role            LobbyRole
  stakeAmount     Int         @map("stake_amount")
  status          LobbyStatus @default(WAITING)
  invitedById     String?     @map("invited_by_id") @db.Uuid
  invitedBy       User?       @relation("LobbyInviter", fields: [invitedById], references: [id])
  betId           String?     @map("bet_id") @db.Uuid
  expiresAt       DateTime    @map("expires_at")
  inviteExpiresAt DateTime?   @map("invite_expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  challengeAsChallenger StreamChallenge? @relation("ChallengeChallengerEntry")
  challengeAsStreamer   StreamChallenge? @relation("ChallengeStreamerEntry")

  @@index([gameType, role, status, expiresAt], map: "idx_lobby_match")
  @@index([userId, status], map: "idx_lobby_user")
  @@map("lobby_entries")
}

model StreamChallenge {
  id                     String                @id @default(cuid())
  challengerUserId       String                @map("challenger_user_id") @db.Uuid
  streamerUserId         String                @map("streamer_user_id") @db.Uuid
  gameType               String                @map("game_type") @db.VarChar(50)
  stakeAmount            Int                   @map("stake_amount")
  requiresReferee        Boolean               @default(false) @map("requires_referee")
  status                 StreamChallengeStatus @default(PENDING)
  challengerLobbyEntryId String                @unique @map("challenger_lobby_entry_id")
  streamerLobbyEntryId   String                @unique @map("streamer_lobby_entry_id")
  betId                  String?               @unique @map("bet_id") @db.Uuid
  expiresAt              DateTime              @map("expires_at")
  respondedAt            DateTime?             @map("responded_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  challenger           User       @relation("ChallengeChallenger", fields: [challengerUserId], references: [id], onDelete: Cascade)
  streamer             User       @relation("ChallengeStreamer", fields: [streamerUserId], references: [id], onDelete: Cascade)
  challengerLobbyEntry LobbyEntry @relation("ChallengeChallengerEntry", fields: [challengerLobbyEntryId], references: [id], onDelete: Cascade)
  streamerLobbyEntry   LobbyEntry @relation("ChallengeStreamerEntry", fields: [streamerLobbyEntryId], references: [id], onDelete: Cascade)
  bet                  Bet?       @relation(fields: [betId], references: [id], onDelete: SetNull)

  @@index([challengerUserId, status, createdAt], map: "idx_stream_challenge_challenger")
  @@index([streamerUserId, status, expiresAt], map: "idx_stream_challenge_streamer")
  @@index([status, expiresAt], map: "idx_stream_challenge_expiry")
  @@map("stream_challenges")
}

// =============================================================================
// KYC / IDENTITY VERIFICATION
// =============================================================================

/// A player's identity verification packet, reviewed manually by an admin.
/// The denormalised `User.kycStatus` mirrors the newest submission's outcome
/// and is what the money paths gate on.
model KycSubmission {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  status         KycSubmissionStatus @default(PENDING)
  legalFirstName String              @map("legal_first_name") @db.VarChar(100)
  legalLastName  String              @map("legal_last_name") @db.VarChar(100)
  dateOfBirth    DateTime            @map("date_of_birth") @db.Date
  addressLine1   String              @map("address_line1") @db.VarChar(200)
  addressLine2   String?             @map("address_line2") @db.VarChar(200)
  city           String              @db.VarChar(100)
  region         String?             @db.VarChar(100)
  postalCode     String              @map("postal_code") @db.VarChar(20)
  country        String              @db.VarChar(2)
  documentType   KycDocumentType     @map("document_type")
  reviewedById   String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at")
  reviewNotes    String?             @map("review_notes") @db.VarChar(1000)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user       User          @relation("KycSubject", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?         @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  KycDocument[]

  @@index([status, createdAt], map: "idx_kyc_submission_status")
  @@index([userId, createdAt], map: "idx_kyc_submission_user")
  @@map("kyc_submissions")
}

/// An uploaded identity document. Bytes are AES-256-GCM encrypted at rest with
/// KYC_DOCUMENT_ENCRYPTION_KEY and are only ever decrypted for an admin
/// reviewer streaming the image back.
model KycDocument {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @map("submission_id") @db.Uuid
  kind         KycDocumentKind
  mimeType     String          @map("mime_type") @db.VarChar(100)
  byteSize     Int             @map("byte_size")
  sha256       String          @db.VarChar(64)
  ciphertext   Bytes
  iv           Bytes
  authTag      Bytes           @map("auth_tag")
  createdAt    DateTime        @default(now()) @map("created_at")

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, kind], map: "uq_kyc_document_submission_kind")
  @@map("kyc_documents")
}

// =============================================================================
// RESPONSIBLE PLAY
// =============================================================================

/// A user-set cap on deposits over a rolling window.
///
/// Decreases apply immediately. Increases are staged in `pendingAmount` and
/// only become effective at `pendingEffectiveAt`, so a limit cannot be raised
/// in the heat of a session.
model DepositLimit {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  period             DepositLimitPeriod
  amount             Decimal            @db.Decimal(14, 2)
  pendingAmount      Decimal?           @map("pending_amount") @db.Decimal(14, 2)
  pendingEffectiveAt DateTime?          @map("pending_effective_at")
  /// Removing a limit loosens it, so it is staged like an increase: the row
  /// stays in force until pendingEffectiveAt, then goes.
  pendingRemoval     Boolean            @default(false) @map("pending_removal")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period], map: "uq_deposit_limit_user_period")
  @@index([pendingEffectiveAt], map: "idx_deposit_limit_pending")
  @@map("deposit_limits")
}

/// A cool-off or self-exclusion period. The period itself is immutable: a
/// break cannot be shortened or lifted early, which is the entire point.
///
/// A self-exclusion does not lapse on its own. Once `endsAt` passes the
/// customer must ask to return (`returnRequestedAt`), and access resumes a
/// cooling-off period later (`returnEffectiveAt`).
model PlayBreak {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  type              PlayBreakType
  startsAt          DateTime      @map("starts_at")
  endsAt            DateTime      @map("ends_at")
  returnRequestedAt DateTime?     @map("return_requested_at")
  returnEffectiveAt DateTime?     @map("return_effective_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, endsAt], map: "idx_play_break_user_active")
  @@map("play_breaks")
}

/// Markers of possible gambling harm, raised against a player rather than a
/// developer. Deliberately NOT an AnomalyAlert: that model is developer-scoped
/// fraud detection ("is this game rigged"), and mixing player welfare into the
/// fraud queue would bury one in the other. A signal here is a prompt to look,
/// never an accusation and never an automatic restriction.
model PlayerRiskSignal {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         PlayerRiskType
  status       PlayerRiskStatus @default(OPEN)
  severity     String           @db.VarChar(20)
  /// What was observed: streak length, stake multiple, deposit count.
  details      Json
  /// Bounds of the behaviour that triggered it, for review without re-querying.
  windowStart  DateTime         @map("window_start")
  windowEnd    DateTime         @map("window_end")
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?        @map("reviewed_at")
  /// What the reviewer concluded and why.
  reviewNotes  String?          @map("review_notes") @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user         User                  @relation("PlayerRiskSubject", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy   User?                 @relation("PlayerRiskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  interactions CustomerInteraction[]

  @@index([status, createdAt], map: "idx_player_risk_status")
  @@index([userId, type, createdAt], map: "idx_player_risk_user_type")
  @@map("player_risk_signals")
}

model ResponsiblePlaySettings {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  /// Minutes between in-session play reminders; null disables them.
  sessionReminderMinutes Int?     @map("session_reminder_minutes")
  /// When the customer answered the set-a-deposit-limit prompt that comes
  /// before their first deposit (whether they set one or declined).
  depositLimitPromptedAt DateTime? @map("deposit_limit_prompted_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("responsible_play_settings")
}

/// Live chat for a match: one room per bet, shared by both players, the
/// referee and — for refereed stream matches — spectators. Moderators
/// soft-delete (deletedAt) so a removed message stays auditable.
model MatchChatMessage {
  id          String    @id @default(uuid()) @db.Uuid
  betId       String    @map("bet_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  body        String    @db.VarChar(280)
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  bet       Bet   @relation(fields: [betId], references: [id], onDelete: Cascade)
  user      User  @relation("ChatAuthor", fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("ChatModerator", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([betId, createdAt], map: "idx_match_chat_bet_created")
  @@index([betId, deletedAt], map: "idx_match_chat_bet_deleted")
  @@index([userId, createdAt], map: "idx_match_chat_user_created")
  @@map("match_chat_messages")
}

/// Transactional outbox for notification emails. Rows are written in the same
/// DB transaction as the event they describe (a settlement, a payout), and the
/// email-delivery worker sends them — so an email can never be queued for
/// something that rolled back, and a mail-provider outage never blocks money.
model EmailOutbox {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  toEmail       String            @map("to_email") @db.VarChar(255)
  template      String            @db.VarChar(64)
  payload       Json
  /// One email per event: doubles as the provider idempotency key.
  dedupeKey     String            @unique @map("dedupe_key") @db.VarChar(255)
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error") @db.VarChar(1000)
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  sentAt        DateTime?         @map("sent_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt], map: "idx_email_outbox_due")
  @@index([userId, createdAt], map: "idx_email_outbox_user")
  @@map("email_outbox")
}

// =============================================================================
// CUSTOMER INTERACTION (harm prevention: identify, act, evaluate)
// =============================================================================

/// One step taken with a customer after a marker of harm: an automated
/// message, a call, an applied restriction. `outcome` records what followed,
/// so the effectiveness of interactions can be evaluated.
model CustomerInteraction {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  riskSignalId      String?            @map("risk_signal_id") @db.Uuid
  type              InteractionType
  /// What the customer was told, or what was done.
  message           String             @db.Text
  /// Null when sent automatically.
  createdById       String?            @map("created_by_id") @db.Uuid
  /// For AUTOMATED_MESSAGE: when the customer dismissed it in-app.
  acknowledgedAt    DateTime?          @map("acknowledged_at")
  outcome           InteractionOutcome @default(PENDING)
  outcomeNotes      String?            @map("outcome_notes") @db.Text
  outcomeRecordedAt DateTime?          @map("outcome_recorded_at")
  followUpAt        DateTime?          @map("follow_up_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user       User              @relation("InteractionSubject", fields: [userId], references: [id], onDelete: Restrict)
  createdBy  User?             @relation("InteractionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  riskSignal PlayerRiskSignal? @relation(fields: [riskSignalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_interaction_user")
  @@index([userId, type, acknowledgedAt], map: "idx_interaction_unacknowledged")
  @@index([outcome, followUpAt], map: "idx_interaction_follow_up")
  @@map("customer_interactions")
}

// =============================================================================
// COMPLAINTS (with ADR escalation)
// =============================================================================

/// A customer complaint. Distinct from a bet Dispute: a complaint can be about
/// anything, has a reference number, and must get a final response within
/// eight weeks, after which the customer may take it to the ADR provider.
model Complaint {
  id                 String            @id @default(uuid()) @db.Uuid
  /// Human-readable, quoted in every email: PS-C-2026-000123.
  reference          String            @unique @db.VarChar(24)
  userId             String?           @map("user_id") @db.Uuid
  name               String            @db.VarChar(120)
  email              String            @db.VarChar(255)
  category           ComplaintCategory
  description        String            @db.Text
  betId              String?           @map("bet_id") @db.Uuid
  status             ComplaintStatus   @default(OPEN)
  receivedAt         DateTime          @default(now()) @map("received_at")
  acknowledgedAt     DateTime?         @map("acknowledged_at")
  /// receivedAt + 8 weeks.
  finalResponseDueAt DateTime          @map("final_response_due_at")
  finalResponse      String?           @map("final_response") @db.Text
  finalResponseAt    DateTime?         @map("final_response_at")
  outcome            ComplaintOutcome?
  handledById        String?           @map("handled_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user      User?            @relation("ComplaintCustomer", fields: [userId], references: [id], onDelete: Restrict)
  handledBy User?            @relation("ComplaintHandler", fields: [handledById], references: [id], onDelete: SetNull)
  events    ComplaintEvent[]

  @@index([status, finalResponseDueAt], map: "idx_complaint_status_due")
  @@index([userId, createdAt], map: "idx_complaint_user")
  @@index([email], map: "idx_complaint_email")
  @@map("complaints")
}

/// The complaint's history: notes, status changes, messages to the customer.
model ComplaintEvent {
  id                String   @id @default(uuid()) @db.Uuid
  complaintId       String   @map("complaint_id") @db.Uuid
  actorId           String?  @map("actor_id") @db.Uuid
  type              String   @db.VarChar(40)
  body              String?  @db.Text
  visibleToCustomer Boolean  @default(false) @map("visible_to_customer")
  createdAt         DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt], map: "idx_complaint_event_thread")
  @@map("complaint_events")
}

// =============================================================================
// ANTI-MONEY LAUNDERING
// =============================================================================

/// A suspicion for the MLRO to look at. Raised automatically by the AML scan
/// or by staff; escalations and SAR decisions are recorded here, the SAR
/// itself is filed with the NCA outside the platform.
model AmlCase {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  /// The other account involved, e.g. the counterparty in chip dumping.
  relatedUserId String?       @map("related_user_id") @db.Uuid
  type          AmlCaseType
  status        AmlCaseStatus @default(OPEN)
  severity      String        @db.VarChar(20)
  details       Json
  assignedToId  String?       @map("assigned_to_id") @db.Uuid
  /// The MLRO's reasoning for escalating, reporting or closing.
  mlroDecision  String?       @map("mlro_decision") @db.Text
  /// NCA reference once a SAR is submitted.
  sarReference  String?       @map("sar_reference") @db.VarChar(100)
  closedAt      DateTime?     @map("closed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user        User          @relation("AmlSubject", fields: [userId], references: [id], onDelete: Restrict)
  relatedUser User?         @relation("AmlRelated", fields: [relatedUserId], references: [id], onDelete: Restrict)
  assignedTo  User?         @relation("AmlAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes       AmlCaseNote[]

  @@index([status, createdAt], map: "idx_aml_case_status")
  @@index([userId, type, status], map: "idx_aml_case_user_type")
  @@map("aml_cases")
}

model AmlCaseNote {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  amlCase AmlCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt], map: "idx_aml_note_case")
  @@map("aml_case_notes")
}

// =============================================================================
// ADMIN AUDIT LOG
// =============================================================================

/// Every privileged action taken by staff. Append-only: a database trigger
/// rejects UPDATE and DELETE.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String?  @map("target_id") @db.VarChar(64)
  details    Json
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt], map: "idx_admin_audit_actor")
  @@index([targetType, targetId], map: "idx_admin_audit_target")
  @@index([createdAt], map: "idx_admin_audit_created")
  @@map("admin_audit_logs")
}
