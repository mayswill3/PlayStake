# ===========================================
# PlayStake Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# --- Database ---
DATABASE_URL="postgresql://playstake:playstake@localhost:5432/playstake"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Security / audit ---
# Used to irreversibly hash IP addresses in append-only referee audit events.
# Generate with: openssl rand -hex 32
AUDIT_IP_SALT="generate-with-openssl-rand-hex-32"
# AES-256 key for encrypting authenticator secrets. Do not reuse in production.
# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# --- Stripe (use test-mode keys for local dev) ---
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Required for Express connected-account test onboarding (for example GB or US).
STRIPE_CONNECT_COUNTRY="GB"

# --- Google OAuth ---
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# --- Kick OAuth ---
# Get these from https://kick.com/settings/developer
# Redirect URI to register: ${NEXT_PUBLIC_APP_URL}/api/auth/kick/callback
KICK_CLIENT_ID="your-kick-client-id"
KICK_CLIENT_SECRET="your-kick-client-secret"
# AES-256 key for encrypting stored Kick access/refresh tokens.
# Generate with: openssl rand -hex 32
KICK_TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
# Optional: override Kick's webhook-verification public key (PEM) for rotation.
# Defaults to the published production key; webhook receiver: /api/webhooks/kick
# KICK_WEBHOOK_PUBLIC_KEY=""

# --- KYC / identity verification ---
# AES-256 key for encrypting stored KYC identity documents at rest.
# Keep this distinct from every other key: it guards the most sensitive
# data PlayStake holds. Generate with: openssl rand -hex 32
KYC_DOCUMENT_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional comma-separated additional trusted origins for API mutation requests.
ALLOWED_ORIGINS=""

# --- Transactional email (Resend) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="PlayStake <support@playstake.org>"

# --- Error tracking (Sentry) ---
# Leave empty to disable entirely: with no DSN the SDK is inert, the build is
# not wrapped, and nothing is sent. Reporting is also limited to production.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time (readable stack traces).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Fraction of requests traced for performance. Errors are always captured.
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Which deploy an error came from. Railway injects RAILWAY_GIT_COMMIT_SHA for
# GitHub-deployed services; set this only if building somewhere that doesn't.
SENTRY_RELEASE=""
